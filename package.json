{
  "name": "audentra-portals",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "vercel-build": "npm run vercel-build --workspace @vv/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm --workspace @vv/web run dev",
    "dev:web": "npm --workspace @vv/web run dev",
    "start": "npm --workspace @vv/web run start",
    "test:e2e": "playwright test",
    "test:contracts": "npm --workspace @vv/contracts run typecheck"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "next": "16.3.5",
    "sharp": "$sharp"
  },
  "dependencies": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
