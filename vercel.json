{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "build": {
    "env": {
      "NEXT_PUBLIC_API_BASE_URL": "",
      "NEXT_PUBLIC_SITE_URL": "https://test.audentra.ai",
      "NEXT_PUBLIC_DEMO_STUDENT_LOGIN_ENABLED": "true",
      "NEXT_PUBLIC_DEMO_STAFF_LOGIN_ENABLED": "true",
      "NEXT_PUBLIC_EDWARD_DEBUG_ENABLED": "true",
      "NEXT_PUBLIC_DEFAULT_TENANT_SLUG": "aster-demo"
    }
  }
}
