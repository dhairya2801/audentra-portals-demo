# Portal settings for manually testing the integration/mock-university-v1
# branch against the integration API (Audentra-platform
# scripts/integration-stack.sh api → http://localhost:4300).
#   cp .env.integration.example .env.local && npm run dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:4300
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo sign-in panels on /sign-in and /staff (development affordances).
NEXT_PUBLIC_DEMO_STUDENT_LOGIN_ENABLED=true
NEXT_PUBLIC_DEMO_STAFF_LOGIN_ENABLED=true
# /dev/edward and /dev/staff-edward (Edward Lab) need a tenant to read against.
NEXT_PUBLIC_EDWARD_DEBUG_ENABLED=true
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=aster-demo
# Server-side only; must match DOCUMENT_WORKER_TOKEN of the integration API.
EDWARD_LAB_WORKER_TOKEN=local-development-document-worker-token
