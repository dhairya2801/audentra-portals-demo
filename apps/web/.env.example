# Public origin of the deployed portal. Vercel preview URLs are inferred when omitted.
NEXT_PUBLIC_SITE_URL=https://portal.example.edu

# Public HTTPS origin of the Audentra API. Set this only when the portal and the
# API answer on the same origin, because the platform issues host-only
# SameSite=lax session cookies. When they are on separate hosts, leave this
# unset and set API_PROXY_ORIGIN instead so next.config.ts proxies /v1/* and the
# session cookie stays first-party.
NEXT_PUBLIC_API_BASE_URL=https://api.example.edu

# Origin of the hosted API to proxy. Mutually exclusive with the value above:
# setting NEXT_PUBLIC_API_BASE_URL sends the browser cross-origin and bypasses
# these rewrites.
# API_PROXY_ORIGIN=https://api.example.edu
