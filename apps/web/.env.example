# Local same-origin API proxy; public values are bundled at build time.
API_PROXY_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_STUDENT_LOGIN_ENABLED=true
NEXT_PUBLIC_DEMO_STAFF_LOGIN_ENABLED=true

# Leave unset with API_PROXY_ORIGIN. Only use an absolute URL when your
# deployment deliberately supports credentialed cross-origin sessions.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional developer Lab (server-only token must match DOCUMENT_WORKER_TOKEN).
# NEXT_PUBLIC_EDWARD_DEBUG_ENABLED=true
# EDWARD_LAB_API_ORIGIN=http://127.0.0.1:4000
# EDWARD_LAB_WORKER_TOKEN=REPLACE_WITH_LOCAL_WORKER_TOKEN
