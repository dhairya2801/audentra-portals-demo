# Public origin of the deployed portal. Vercel preview URLs are inferred when omitted.
NEXT_PUBLIC_SITE_URL=https://portal.example.edu

# Use the isolated browser staff demo when no hosted API is available.
NEXT_PUBLIC_STAFF_DEMO_MODE=true

# Public HTTPS origin of the Audentra API. Omit this for the staff-only Vercel demo.
NEXT_PUBLIC_API_BASE_URL=https://api.example.edu
