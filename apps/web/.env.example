# Public origin of the deployed portal. Vercel preview URLs are inferred when omitted.
NEXT_PUBLIC_SITE_URL=https://portal.example.edu

# Public HTTPS origin exposed directly to browser code. Hosted split deployments
# must leave this unset so the portal worker intercepts /v1/* and keeps the
# platform's host-only SameSite=lax session cookie first-party.
NEXT_PUBLIC_API_BASE_URL=https://api.example.edu

# Origin of the hosted API reached by the portal's same-origin /v1 route. Leave
# NEXT_PUBLIC_API_BASE_URL unset in this mode. API_PROXY_ORIGIN remains a local
# compatibility alias, but new hosted deployments should use PLATFORM_API_ORIGIN.
# PLATFORM_API_ORIGIN=https://api.example.edu

# Cloud Run only: authenticate the server-to-server hop to an IAM-private API.
# Both values stay server-side. The audience normally equals the API origin.
# PLATFORM_API_AUTH_MODE=google
# PLATFORM_API_AUDIENCE=https://api.example.edu

# Set only behind a trusted reverse proxy. The supplied Cloud Run image sets
# this so Vinext reconstructs the public request as HTTPS.
# VINEXT_TRUST_PROXY=1

# A hosted API without Google IAM requires a deliberate server-side opt-in.
# Do not use this for the private Audentra Cloud Run platform.
# PLATFORM_API_ALLOW_UNAUTHENTICATED=false

# --- Demo student sign-in (development affordance on /sign-in) ---------------
# The demo campus (`/aster-demo`) holds a few thousand students with genuinely
# different state, and testing against it means opening a chosen one. The
# panel is on automatically under `npm run dev`; outside development it needs
# this opt-in. The platform disables the route it calls in production
# regardless, so this only decides whether the box is drawn.
# NEXT_PUBLIC_DEMO_STUDENT_LOGIN_ENABLED=true
# The staff counterpart ("Log in as synthetic staff" under /staff sign-in) follows the
# student flag unless set explicitly. The platform disables both routes in production.
# NEXT_PUBLIC_DEMO_STAFF_LOGIN_ENABLED=true

# --- Edward Lab (developer trace dashboard, /dev/edward) ---------------------
# The Lab is on automatically under `npm run dev`. Outside development it
# requires this explicit build-time opt-in; never enable it on a student-facing
# production deployment.
# NEXT_PUBLIC_EDWARD_DEBUG_ENABLED=true

# Server-side only (route handlers): where the Lab proxy reaches the platform
# API and the internal credential it presents. Defaults: the API origin falls
# back to API_PROXY_ORIGIN / NEXT_PUBLIC_API_BASE_URL / http://localhost:4000,
# and in development the token falls back to the platform's documented local
# default. These are NOT NEXT_PUBLIC_ values and never reach the browser.
# EDWARD_LAB_API_ORIGIN=http://localhost:4000
# EDWARD_LAB_WORKER_TOKEN=local-development-document-worker-token
